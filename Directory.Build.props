<Project>

  <!-- Technical defaults only. Deliberately carries no package metadata, no version and no
       packaging: this branch is kept close to upstream so merges stay cheap, and the package
       identity is applied by the release tooling at pack time rather than committed here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Off by default so the demos can never accidentally ship; the library switches it on. -->
    <IsPackable>false</IsPackable>

    <!-- Upstream's library pins Avalonia 12.0.2 directly; this line takes 12.1.0. The 11.1.0 in
         upstream's src/Directory.Build.props is stale and unused by the library. -->
    <AvaloniaVersion>12.1.0</AvaloniaVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The PTY layer, named by property. These defaults ARE upstream's dependency, so a plain
         clone of this branch builds and packs exactly as upstream does and nothing here presumes a
         particular downstream.

         A downstream carrying a patched PTY fork overrides both at pack time. It has to: that fork
         keeps the Porta.Pty NAMESPACE deliberately, so a graph containing both packages makes every
         type ambiguous. Substituting rather than adding is the only safe shape. -->
    <PtyPackageId Condition="'$(PtyPackageId)' == ''">Porta.Pty</PtyPackageId>
    <PtyPackageVersion Condition="'$(PtyPackageVersion)' == ''">1.0.7</PtyPackageVersion>
  </PropertyGroup>

</Project>
