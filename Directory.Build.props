<Project>

  <!-- Technical defaults only. Deliberately carries no package metadata, no version and no
       packaging: this branch is kept close to upstream so merges stay cheap, and the package
       identity is applied by the release tooling at pack time rather than committed here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Off by default so the demos can never accidentally ship; the library switches it on. -->
    <IsPackable>false</IsPackable>

    <!-- Upstream's library pins Avalonia 12.0.2 directly; this line takes 12.1.0. The 11.1.0 in
         upstream's src/Directory.Build.props is stale and unused by the library. -->
    <AvaloniaVersion>12.1.0</AvaloniaVersion>
  </PropertyGroup>

</Project>
