<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Iciclecreek.Terminal</AssemblyName>
    <RootNamespace>Iciclecreek.Terminal</RootNamespace>
    <IsPackable>true</IsPackable>

    <!-- Version lives here, matching upstream's convention, and continues upstream's line rather
         than starting a new one: this branch IS upstream plus a patch set, so a number below theirs
         would claim to be older than the code it contains. The release tooling applies the package
         identity at pack time; only the number is committed. -->
    <Version>2.0.5</Version>
    <AssemblyVersion>2.0.4.0</AssemblyVersion>
    <!-- XML docs ride along: this is consumed as a compiled reference, so the doc comments
         explaining the seams are the only design notes a consumer ever sees. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Avalonia terminal control (TerminalView / TerminalControl / TerminalWindow) hosting an XTerm console over a PTY. Fork of tomlm/Iciclecreek.Avalonia.Terminal, substantially modified.</Description>
    <PackageTags>avalonia;terminal;xterm;pty</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../icon.png" Pack="true" PackagePath="" />
    <!-- MIT requires the notice to travel with the code, so it ships inside the package too. -->
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <!-- The PTY package is named by a property so a downstream build can substitute a patched fork
         without editing this file. Defaults to upstream's, so a plain clone builds exactly as
         upstream does; see Directory.Build.props. -->
    <PackageReference Include="$(PtyPackageId)" Version="$(PtyPackageVersion)" />
    <PackageReference Include="Unicode.net" Version="2.0.0" />
    <PackageReference Include="Wcwidth" Version="4.0.1" />
    <PackageReference Include="XTerm.NET" Version="1.0.14" />
  </ItemGroup>

</Project>
